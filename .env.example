# Copy this file to ".env" and fill in your SMTP credentials.
# Real email delivery turns on automatically once EMAIL_HOST is set
# (otherwise emails are printed to the console).

# ---- Pick ONE provider preset and fill USER/PASSWORD below ----

# Gmail (requires a Google "App Password", not your normal password):
#   EMAIL_HOST=smtp.gmail.com
#   EMAIL_PORT=587
#   EMAIL_USE_TLS=true
#   EMAIL_USE_SSL=false

# Yandex:
#   EMAIL_HOST=smtp.yandex.ru
#   EMAIL_PORT=465
#   EMAIL_USE_TLS=false
#   EMAIL_USE_SSL=true

# Mail.ru:
#   EMAIL_HOST=smtp.mail.ru
#   EMAIL_PORT=465
#   EMAIL_USE_TLS=false
#   EMAIL_USE_SSL=true

EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USE_TLS=true
EMAIL_USE_SSL=false
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=orders@example.com

# ---- Database ----
# PostgreSQL is used when DB_NAME is set; leave DB_NAME empty to use SQLite.
DB_NAME=ams
DB_USER=postgres
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432

# ---- 1C (УНФ) product sync ----
# Endpoints returning the products / debts JSON, plus shared basic-auth creds.
# Used by:  python manage.py sync_erp   (products: prices + stock)
#           python manage.py sync_debts (Company debt, matched by code)
# The endpoints are on the local network, so the commands must run from a
# machine on that LAN. To update production, run locally with DATABASE_URL set
# to the Render Postgres external URL (the schedule wrapper does this).
ERP_PRODUCTS_URL=http://192.168.0.10/UNF3/hs/test/products
ERP_DEBTS_URL=http://192.168.0.10/UNF3/hs/test/debts
ERP_USER=
ERP_PASSWORD=
