# Copy this file to ".env" and fill in your SMTP credentials.
# Real email delivery turns on automatically once EMAIL_HOST is set
# (otherwise emails are printed to the console).

# ---- Pick ONE provider preset and fill USER/PASSWORD below ----

# Gmail (requires a Google "App Password", not your normal password):
#   EMAIL_HOST=smtp.gmail.com
#   EMAIL_PORT=587
#   EMAIL_USE_TLS=true
#   EMAIL_USE_SSL=false

# Yandex:
#   EMAIL_HOST=smtp.yandex.ru
#   EMAIL_PORT=465
#   EMAIL_USE_TLS=false
#   EMAIL_USE_SSL=true

# Mail.ru:
#   EMAIL_HOST=smtp.mail.ru
#   EMAIL_PORT=465
#   EMAIL_USE_TLS=false
#   EMAIL_USE_SSL=true

EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USE_TLS=true
EMAIL_USE_SSL=false
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=orders@example.com

# ---- Database ----
# PostgreSQL is used when DB_NAME is set; leave DB_NAME empty to use SQLite.
DB_NAME=ams
DB_USER=postgres
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432

# ---- 1C (УНФ) product sync ----
# Endpoints returning the products / debts JSON, plus shared basic-auth creds.
# Used by:  python manage.py sync_erp   (products: prices + stock)
#           python manage.py sync_debts (Company debt, matched by code)
# The endpoints are on the local network, so the commands must run from a
# machine on that LAN. To update production, run locally with DATABASE_URL set
# to the Render Postgres external URL (the schedule wrapper does this).
ERP_PRODUCTS_URL=http://192.168.0.10/UNF3/hs/test/products
ERP_DEBTS_URL=http://192.168.0.10/UNF3/hs/test/debts
ERP_USER=
ERP_PASSWORD=

# Email order import (import_email_orders command). Polls one IMAP mailbox and,
# per client "source", turns order spreadsheets into pending Orders.
ORDER_IMAP_HOST=imap.yandex.ru
ORDER_IMAP_PORT=993
ORDER_IMAP_USER=
ORDER_IMAP_PASSWORD=
ORDER_DEFAULT_WAREHOUSE=Новокузнецк
#
# Each client is a "source": list their names in ORDER_SOURCES, then give each a
# group of ORDER_<NAME>_* vars (NAME upper-cased, '-' → '_'):
#   ORDER_<NAME>_FOLDER             IMAP folder the client's mail is filed into
#   ORDER_<NAME>_FORMAT             nkoil_sections (Точка продаж, match nkoil_code)
#                                   | price_list (filled catalog, match sku)
#   ORDER_<NAME>_MATCH_BY           nkoil_code | sku
#   ORDER_<NAME>_SENDERS            comma whitelist (empty = any sender)
#   ORDER_<NAME>_USER_MAP           "addr=login,addr2=login2" (map mode)
#   ORDER_<NAME>_RESOLVE_BY_EMAIL   true = match sender to an account's email
# Example (two clients):
#   ORDER_SOURCES=nkoil,avramenko
#   ORDER_NKOIL_FOLDER=nk-oil
#   ORDER_NKOIL_FORMAT=nkoil_sections
#   ORDER_NKOIL_MATCH_BY=nkoil_code
#   ORDER_NKOIL_SENDERS=a@nk-oil.com,b@nk-oil.com
#   ORDER_NKOIL_USER_MAP=a@nk-oil.com=nk-oil,b@nk-oil.com=nk-oil
#   ORDER_AVRAMENKO_FOLDER=avramenko
#   ORDER_AVRAMENKO_FORMAT=price_list
#   ORDER_AVRAMENKO_MATCH_BY=sku
#   ORDER_AVRAMENKO_RESOLVE_BY_EMAIL=true
ORDER_SOURCES=
