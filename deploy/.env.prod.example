# Production environment for the all-in-one VPS (Timeweb).
# Copy to deploy/.env.prod on the server and fill in. NEVER commit .env.prod.
# Copy the email values from the Render dashboard.

# ---- Core ----
DEBUG=False
# Generate a NEW key:  python3 -c "import secrets;print(secrets.token_urlsafe(64))"
SECRET_KEY=
# Include the raw IP too so you can smoke-test before DNS is cut over.
ALLOWED_HOSTS=a-sibir.ru,www.a-sibir.ru,201.24.115.147
CSRF_TRUSTED_ORIGINS=https://a-sibir.ru,https://www.a-sibir.ru

# ---- HTTPS (Caddy terminates TLS and sets X-Forwarded-Proto) ----
# Keep these False during the http/self-signed rehearsal; set True at cutover.
SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False
SECURE_HSTS_SECONDS=0

# ---- Database (Postgres runs in the db container) ----
# POSTGRES_* configure the container; DB_* tell Django how to connect. Keep the
# user/password identical across both groups.
POSTGRES_DB=ams
POSTGRES_USER=ams
POSTGRES_PASSWORD=CHANGE_ME_strong_password
DB_NAME=ams
DB_USER=ams
DB_PASSWORD=CHANGE_ME_strong_password
DB_HOST=db
DB_PORT=5432

# ---- Media ----
# Left unset on purpose: with no AWS_STORAGE_BUCKET_NAME the app stores uploads
# on local disk (/app/media), and Caddy serves them. Nothing to configure.

# ---- Email (copy from the Render dashboard; template uses Yandex/Mail.ru) ----
EMAIL_HOST=
EMAIL_PORT=465
EMAIL_USE_SSL=True
EMAIL_USE_TLS=False
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=

# ---- Runtime ----
GUNICORN_WORKERS=3
# Do NOT set SEED_DEMO in production.
