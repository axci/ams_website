# Copy to ".env.docker" and fill in real values, then:
#   docker compose up -d --build
# NOTE: the DB_* values (used by Django) MUST match the POSTGRES_* values
# (used to initialise the database container).

# --- Django ---
# Generate: python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=change-me
DEBUG=False
ALLOWED_HOSTS=your-domain.ru,www.your-domain.ru
CSRF_TRUSTED_ORIGINS=https://your-domain.ru,https://www.your-domain.ru

# --- Database (DB_HOST is set to "db" by docker-compose) ---
DB_NAME=ams
DB_USER=ams_user
DB_PASSWORD=change-me-db-password
DB_PORT=5432
POSTGRES_DB=ams
POSTGRES_USER=ams_user
POSTGRES_PASSWORD=change-me-db-password

# --- Email (Yandex) ---
EMAIL_HOST=smtp.yandex.ru
EMAIL_PORT=465
EMAIL_USE_SSL=true
EMAIL_USE_TLS=false
EMAIL_HOST_USER=your-mailbox@yandex.ru
EMAIL_HOST_PASSWORD=your-app-password
DEFAULT_FROM_EMAIL=your-mailbox@yandex.ru

# --- HTTPS: enable these once TLS is terminated in front of nginx ---
# SECURE_SSL_REDIRECT=true
# SESSION_COOKIE_SECURE=true
# CSRF_COOKIE_SECURE=true
# SECURE_HSTS_SECONDS=31536000
# SECURE_HSTS_INCLUDE_SUBDOMAINS=true
# SECURE_HSTS_PRELOAD=true

# --- Gunicorn (optional tuning) ---
# GUNICORN_WORKERS=3
